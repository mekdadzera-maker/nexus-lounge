{
  "name": "Bookings",
  "type": "object",
  "properties": {
    "station_id": {
      "type": "string"
    },
    "station_name": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "booking_mode": {
      "type": "string"
    },
    "pricing_tier_id": {
      "type": "string"
    },
    "booking_quantity": {
      "type": "number",
      "default": 1
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "total_price": {
      "type": "number"
    },
    "reservation_code": {
      "type": "string"
    },
    "contact_method": {
      "type": "string",
      "enum": [
        "Phone",
        "Facebook Messenger"
      ],
      "default": "Phone"
    },
    "fallback_contact_info": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Deposit Paid",
        "Completed"
      ],
      "default": "Pending"
    }
  },
  "required": [
    "station_id",
    "station_name",
    "customer_name",
    "customer_phone",
    "booking_date",
    "booking_mode",
    "booking_quantity",
    "start_time",
    "total_price",
    "contact_method",
    "payment_status"
  ]
}